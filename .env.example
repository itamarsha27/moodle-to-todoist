# Copy to .env for local runs (.env is git-ignored).
# On GitHub, the two secrets go in Settings → Secrets and variables → Actions.

# REQUIRED. Moodle → Calendar → Export calendar → Get calendar URL.
# Contains a personal token: treat it like a password.
MOODLE_ICAL_URL=https://moodle.example.ac.il/calendar/export_execute.php?userid=12345&authtoken=REPLACE_ME&preset_what=all&preset_time=recentupcoming

# REQUIRED. Todoist → Settings → Integrations → Developer → API token.
TODOIST_API_TOKEN=REPLACE_ME

# Optional (defaults shown)
# TODOIST_PROJECT=University        # project that holds all synced tasks
# TODOIST_LABEL=moodle              # every synced task gets this label; only these are ever touched
# TODOIST_COURSE_SECTIONS=true      # one section per course inside the project
# TODOIST_COURSE_LABELS=true        # plus a label per course, e.g. @Data_Structures
# TIMEZONE=Asia/Jerusalem
# HORIZON_DAYS=180                  # ignore deadlines further out than this (Moodle's own export limit may be shorter)
# PRUNE_AFTER_DAYS=30               # forget tasks this long after their deadline
# LOG_LEVEL=INFO
